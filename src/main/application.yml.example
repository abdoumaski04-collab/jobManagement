spring:
  application:
    name: JobManagement
  profiles:
      active: dev

  datasource:
    url: jdbc:postgresql://localhost:5432/dbname
    username: 
    password: 
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: false


server:
port: 8080